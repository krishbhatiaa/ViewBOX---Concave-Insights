digraph F{rankdir=TB;node[shape=box,style="rounded,filled",fillcolor="#eef2ff",fontname="Helvetica",color="#3b5bdb"];edge[fontname="Helvetica",fontsize=10];label="ViewBox - user flow of main screens and steps";labelloc=t;fontsize=16;fontname="Helvetica"
link[label="Link opened\n/signup?src=TOKEN or ?ref=TOKEN"];chk[shape=diamond,label="HMAC valid?"];how[label="Ask: How did you hear about us?\n(dropdown)"];
src[label="Save source\n(first + last touch)"];ref[label="Save referrer\nsource = Referral"];phone[label="Screen 1: Enter phone"];otp[label="Screen 2: Mock OTP shown on screen"];ex[shape=diamond,label="Existing member?"];
prof[label="Screen 3: Profile\nname, DOB, gender, city, income, interests"];home[label="Screen 4: Home\nlive surveys, interest matches highlighted"];
elig[label="Eligibility result per survey\nApproved / Rejected / Waitlisted + reason\n3-month cool-off date"];myref[label="Screen 5: My referrals\nfriend stage, failure reason, masked phone"];
link->chk;chk->src[label="src"];chk->ref[label="ref"];chk->how[label="none / invalid"];src->phone;ref->phone;how->phone;phone->otp->ex;ex->home[label="yes"];ex->prof[label="no"];prof->home;home->elig;home->myref;
admin[label="Admin login",fillcolor="#fff4e6",color="#d9480f"];grid[label="Respondent grid\nsearch, filter, export CSV",fillcolor="#fff4e6",color="#d9480f"];srcs[label="Sources\nadd source, copy signed link",fillcolor="#fff4e6",color="#d9480f"];
stage[label="Mark Lead -> Fit -> Completed\nor Failed + reason",fillcolor="#fff4e6",color="#d9480f"];dash[label="Source dashboard\nsign-ups, Fit, Completed",fillcolor="#fff4e6",color="#d9480f"];imp[label="CSV import\nfixed / skipped report",fillcolor="#fff4e6",color="#d9480f"];surv[label="Create survey + rules\n(Strict / Flexible)",fillcolor="#fff4e6",color="#d9480f"];
admin->grid;admin->srcs;admin->dash;admin->imp;admin->surv;grid->stage;stage->myref[style=dashed,label="visible to referrer"];srcs->link[style=dashed,label="shared link"];
meta[label="Meta lead ad",fillcolor="#e6fcf5",color="#087f5b"];api[label="POST /api/meta/lead\nvalidate, dedupe by lead_id",fillcolor="#e6fcf5",color="#087f5b"];mem[label="Member created\nsource = Meta Ads + campaign_id",fillcolor="#e6fcf5",color="#087f5b"];meta->api->mem->grid;}