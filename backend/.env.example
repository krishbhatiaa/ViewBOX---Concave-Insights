APP_SECRET=change-me-long-random-string
FRONTEND_URL=http://localhost:8000
DATABASE_URL=sqlite:///./viewbox.db

# Optional: max signup/OTP requests per IP per hour (default 60)
SIGNUP_IP_LIMIT=60

# Optional: shared secret for the Meta lead webhook.
# When set, POST /api/meta/lead must send X-Hub-Signature-256: sha256=<hmac-sha256 of raw body>
# or X-Webhook-Token: <this secret>. When unset, the endpoint accepts unsigned leads (dev mode).
# META_WEBHOOK_SECRET=change-me-too
