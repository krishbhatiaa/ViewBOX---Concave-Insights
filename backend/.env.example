APP_SECRET=change-me-long-random-string
FRONTEND_URL=http://localhost:8000
DATABASE_URL=sqlite:///./viewbox.db

# Optional: max signup/OTP requests per IP per hour (default 60)
SIGNUP_IP_LIMIT=60

# Optional: shared secret for the Meta lead webhook.
# When set, POST /api/meta/lead must send X-Hub-Signature-256: sha256=<hmac-sha256 of raw body>
# or X-Webhook-Token: <this secret>. When unset, the endpoint accepts unsigned leads (dev mode).
# META_WEBHOOK_SECRET=change-me-too

# Optional: LLM used by POST /api/admin/suggest-rules (survey rule suggestions).
# OpenAI-compatible chat completions API. When LLM_API_KEY is unset, the endpoint
# falls back to deterministic offline keyword suggestions (feature stays usable).
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Optional: Google Sheets push/pull. Service-account JSON (whole object as one line).
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# SPREADSHEET_ID=your-spreadsheet-id
