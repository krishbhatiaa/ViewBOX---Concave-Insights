APP_SECRET=change-me-long-random-string
FRONTEND_URL=http://localhost:8000
DATABASE_URL=sqlite:///./viewbox.db

# Optional: max signup/OTP requests per IP per hour (default 60)
SIGNUP_IP_LIMIT=60

# Rate limiting backend: memory (prototype, single worker) or redis (production swap)
# RATE_LIMIT_BACKEND=memory
# Workers > 1 with the memory backend logs a startup warning.
# WEB_CONCURRENCY=1

# Optional: maximum survey cycle length in days from launch (default 15).
SURVEY_MAX_CYCLE_DAYS=15

# Optional: Meta webhook verification handshake (GET /webhooks/meta).
# META_VERIFY_TOKEN=change-me-too

# Optional: Graph API token for wrapped leadgen_id envelopes.
# Without it, wrapped leads are fetched from the built-in mock fetcher.
# META_PAGE_ACCESS_TOKEN=EAAG...

# Optional: shared secret for the Meta lead webhook.
# When set, POST /api/meta/lead must send X-Hub-Signature-256: sha256=<hmac-sha256 of raw body>.
# When unset, the endpoint accepts unsigned leads (dev mode only).
# META_WEBHOOK_SECRET=change-me-too

# Optional: LLM used by POST /api/admin/suggest-rules (survey rule suggestions).
# OpenAI-compatible chat completions API. When LLM_API_KEY is unset, the endpoint
# falls back to deterministic offline keyword suggestions (feature stays usable).
# Groq example (console.groq.com/keys):
# LLM_API_KEY=gsk_your_groq_key
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# OpenAI default (if you leave the two lines above unset):
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Optional: Google Sheets push/pull. Service-account JSON (whole object as one line).
# Enable Google Forms API + Google Drive API in the service account's Cloud project.
# Paste the whole downloaded JSON key as ONE LINE (single quotes keep the JSON intact).
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"...","token_uri":"..."}'
# SPREADSHEET_ID=your-spreadsheet-id

# Optional: Google Forms are created for every new survey. With credentials the form is
# created live through the Forms API; without them a local mock responder link is stored.
# A service-account form is not visible to your Google account until it is shared.
# Comma-separated emails get reader access automatically; otherwise the link shows
# "Sorry, the file you have requested does not exist" in a normal browser session.
# GOOGLE_FORM_SHARE_WITH=you@gmail.com,ops@example.com
# GOOGLE_FORM_RESPONSES_SHEET_ID=your-linked-form-responses-sheet-id
# GOOGLE_FORM_RESPONSES_WORKSHEET=Form Responses 1
# Without the credentials/sheet ID above, sync reads the bundled local demo responses
# from data/google_form_responses.csv. Point this at another CSV to supply your own rows.
# GOOGLE_FORM_RESPONSES_LOCAL_PATH=/absolute/path/to/google_form_responses.csv
# GOOGLE_FORM_XLSX_PATH=/absolute/path/to/google_form_leads.xlsx

# Optional: shared secret for Google Form response webhooks.
# POST /api/google-forms/lead then needs X-Google-Forms-Signature-256: sha256=<hmac-sha256 of raw body>.
# GOOGLE_FORMS_WEBHOOK_SECRET=change-me-too
